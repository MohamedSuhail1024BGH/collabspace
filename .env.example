# CollabSpace environment variables
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real credentials.
# This .env.example file contains placeholders only and is safe to commit.

# ─── Required ───────────────────────────────────────────────────────────────

# Supabase Postgres connection string (Transaction Pooler, port 6543).
# Supabase Dashboard → Connect → Transaction pooler.
# Note: `prepare: false` and `sslmode=require` are required for the pooler and
# are already enforced in code (lib/db/index.ts).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct (non-pooler) Postgres connection, used by Drizzle Kit migrations
# (drizzle.config.ts). Falls back to DATABASE_URL when unset.
# Supabase Dashboard → Connect → Session pooler, or the direct DB URL.
DATABASE_DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Optional ───────────────────────────────────────────────────────────────

# Public base URL used for canonical links, robots.txt, and the sitemap
# (app/layout.tsx, app/robots.ts, app/sitemap.ts).
# Defaults to https://collabspace.app when unset. Use your deployed URL in
# production, e.g. https://collabspace-ten.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safety guard for the E2E database reseeder (lib/db/seed-test.ts).
# The reseeder TRUNCATEs every table and refuses to run when DATABASE_URL
# points at a Supabase host unless this is exactly "1". Leave unset for
# normal development; only set it when you intend to wipe the target DB
# for `npm run test:e2e`.
# E2E_ALLOW_TRUNCATE=1

# ─── Managed automatically — do not set locally ─────────────────────────────
# NODE_ENV      set by Next.js (development / production)
# CI            set by your CI provider; enables Playwright forbidOnly
# VERCEL_*      injected by the Vercel CLI during `vercel link` / deploys
